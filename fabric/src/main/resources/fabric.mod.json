{
  "schemaVersion": 1,
  "id": "saeculariacaudices",
  "version": "${version}",

  "name": "Saecularia Caudices",
  "description": "Library mod that makes blocks properties world aware.",
  "authors": [
    "OrionOnline"
  ],
  "contact": {
    "sources": "https://github.com/Communi-Suggestu/Saecularia-Caudices"
  },

  "license": "MIT",
  "icon": "logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.communi.suggestu.saecularia.caudices.fabric.Fabric"
    ],
    "client": [
      "com.communi.suggestu.saecularia.caudices.fabric.client.FabricClient"
    ]
  },
  "mixins": [
    "saeculariacaudices.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=$project.fabric.loader.version",
    "fabric": "=>$project.fabric.api.version",
    "minecraft": ["${minecraft.version.get()}"],
    "java": ">=17"
  },
  "suggests": {
  }
}
